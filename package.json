{
  "name": "@md-code/entities-uniqueness",
  "version": "0.1.0",
  "description": "ESLint rule + CLI that finds duplicate entities (classes, interfaces, object shapes, constructor functions) sharing the same members across the codebase — they should be declared once.",
  "license": "MIT",
  "main": "index.js",
  "bin": {
    "md-code-entities-uniqueness": "main.js"
  },
  "files": [
    "index.js",
    "plugin.js",
    "config.js",
    "main.js",
    "logger.js",
    "utils.js",
    "decision-maker.js",
    "report.js",
    "suggester.js",
    "normalizer/",
    "frameworks/",
    "matcher/",
    "filter/",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./plugin": "./index.js",
    "./config": "./config.js",
    "./report": "./report.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "gen:catalog": "node main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "class-validator": "^0.15.1",
    "minimatch": "^9.0.4",
    "mobx": "^7.0.6",
    "ts-morph": "^28.0.0",
    "typescript": "^5.5.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "eslint": ">=8.40.0"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "eslint",
    "eslint-rule",
    "duplicate-entities",
    "code-duplication",
    "refactoring",
    "typescript"
  ]
}
