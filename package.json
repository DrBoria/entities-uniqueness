{
  "name": "@md-code/entities-uniqueness",
  "version": "0.8.0",
  "description": "ESLint rule + CLI that finds duplicate entities (classes, interfaces, object shapes, constructor functions) sharing the same members across the codebase — they should be declared once.",
  "license": "Apache-2.0",
  "author": "DrBoria <dr.boria@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrBoria/entities-uniqueness.git"
  },
  "bugs": {
    "url": "https://github.com/DrBoria/entities-uniqueness/issues"
  },
  "homepage": "https://github.com/DrBoria/entities-uniqueness#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "md-code-entities-uniqueness": "dist/main.js"
  },
  "files": [
    "dist/",
    "report/user-report/src/",
    "README.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./plugin": "./dist/index.js",
    "./config": "./dist/config.js",
    "./report": "./dist/report.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:catalog": "node dist/main.js",
    "overview": "node dist/main.js --overview",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@md-code/code-diff": "file:../code-diff",
    "@reduxjs/toolkit": "^2.13.0",
    "class-validator": "^0.15.1",
    "esbuild": "^0.28.2",
    "minimatch": "^9.0.4",
    "mobx": "^7.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "styled-components": "^6.6.0",
    "ts-morph": "^28.0.0",
    "typescript": "^5.5.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "eslint": ">=8.40.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prismjs": "^1.30.0",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "eslint",
    "eslint-rule",
    "duplicate-entities",
    "code-duplication",
    "refactoring",
    "typescript"
  ]
}
